# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca faça commit do arquivo ".env" (ele contém segredos).

JWT_SECRET=

DB_DW_USER=
DB_DW_HOST=
DB_DW_NAME=
DB_DW_PASSWORD=
DB_DW_PORT=5432

DB_APP_HOST=
DB_APP_USER=
DB_APP_PASSWORD=
DB_APP_NAME=
DB_APP_PORT=3306

EMAIL_USER=
EMAIL_PASS=

PORT=8010
# Origens permitidas para CORS, separadas por vírgula (ex.: http://localhost:8010).
# Como o próprio servidor serve o frontend, o uso normal é mesma-origem.
# Deixe '*' apenas se realmente precisar liberar geral (não recomendado).
CORS_ORIGIN=http://localhost:8010

# --- Movimentações de Setor (e-mail mensal aos gestores) ---
# Endereço que aparece no link do e-mail enviado ao gestor - precisa ser um
# endereço que ELE consiga acessar de outro computador (NÃO use localhost).
# Exemplo: http://localhost:8010
APP_BASE_URL=http://localhost:8010
# Dia do mês em que o disparo automático mensal roda (olha pro mês anterior).
MOVIMENTACAO_DISPATCH_DAY=5
# Depois de quantos dias o link de resposta do gestor expira.
MOVIMENTACAO_TOKEN_EXPIRA_DIAS=60
